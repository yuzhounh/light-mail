<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#3B7DDD</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#EFF4FC</item>
        <item name="android:navigationBarColor">#FAFBFD</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowBackground">#FAFBFD</item>
        <item name="android:alertDialogTheme">@style/CompactDialog</item>
        <item name="android:textAppearanceListItem">@style/CompactListText</item>
    </style>
    <style name="CompactListText" parent="android:style/TextAppearance.Material.Subhead">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="CompactDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#3B7DDD</item>
        <item name="android:textAppearanceListItem">@style/CompactListText</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
